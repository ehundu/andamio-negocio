{% extends 'plantillas/base.twig' %}

{# La lista de todos los servicios, con su precio y su duración #}
{% block cuerpo %}
<div class="contenedor listado">
  <h1>{{ pagina.titulo }}</h1>
  <div class="prosa">{{ pagina.contenido }}</div>
  <ul class="tarjetas">
    {% for s in coleccion('servicios')|orden('orden') %}
    {% include 'parciales/tarjeta-servicio.twig' %}
    {% endfor %}
  </ul>
</div>
{% endblock %}
