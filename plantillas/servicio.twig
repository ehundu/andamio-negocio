{% extends 'plantillas/base.twig' %}

{# La ficha de un servicio: su precio, lo que dura, lo que incluye, el texto y cómo pedir cita #}
{% block cuerpo %}
{% set n = datos.negocio %}
<article class="contenedor ficha">
  <header>
    <p class="antetitulo"><a href="/servicios/">Servicios</a></p>
    <h1>{{ pagina.titulo }}</h1>
    {% if pagina.descripcion %}<p class="ficha__resumen">{{ pagina.descripcion }}</p>{% endif %}
  </header>

  <dl class="ficha__datos">
    {% if pagina.precio %}<div><dt>Precio</dt><dd>{{ pagina.precio }}</dd></div>{% endif %}
    {% if pagina.duracion %}<div><dt>Duración</dt><dd>{{ pagina.duracion }}</dd></div>{% endif %}
  </dl>

  {% if pagina.incluye %}
  <h2>Qué incluye</h2>
  <ul class="ficha__incluye">
    {% for i in pagina.incluye %}<li>{{ i }}</li>{% endfor %}
  </ul>
  {% endif %}

  <div class="prosa">{{ pagina.contenido }}</div>

  <aside class="ficha__cita">
    <h2>Pide cita</h2>
    <p>Llámanos al <a href="tel:{{ n.telefonoInternacional }}">{{ n.telefono }}</a>{% if n.whatsapp %}, escríbenos por <a href="https://wa.me/{{ n.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp<span class="oculto"> (se abre en una pestaña nueva)</span></a>{% endif %} o pásate por el local: te atendemos en el horario de <a href="/donde-estamos/">dónde estamos</a>.</p>
  </aside>
</article>
{% endblock %}
